# Display + set-fees.mjs defaults. On-chain config is the source of truth
# after `node scripts/set-fees.mjs`. 0 / 0 = free launches, no graduation tax.
LAUNCH_FEE_LAMPORTS=0
LAUNCH_TAX_BPS=0
NEXT_PUBLIC_LAUNCH_FEE_LAMPORTS=0
NEXT_PUBLIC_LAUNCH_TAX_BPS=0

# Entry gate — UI-only sessions. set-gate.mjs arms the on-chain gate with
# this key's pubkey; /api/session/sign co-signs entry txs with it. JSON
# secret-key array or a path to one. Server-only, never NEXT_PUBLIC.
GATE_KEYPAIR=
# Privy server credentials. When set, /api/session/sign requires a valid
# Privy access token before co-signing — set them anywhere real money is.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
